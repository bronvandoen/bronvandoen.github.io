---
import Base from '../../layouts/Base.astro';
import Overprint from '../../components/Overprint.astro';
import EntryCard from '../../components/EntryCard.astro';
import { allEntries, categories } from '../../lib/entries';

export async function getStaticPaths() {
  const entries = await allEntries();
  return categories.map((c) => ({ params: { category: c.slug }, props: { c, entries: entries.filter((e) => e.data.kind === c.kind) } }));
}
const { c, entries } = Astro.props;
---
<Base title={c.label} description={c.about} current="categories">
  <p class="eyebrow"><a href="/categories/">Category</a></p>
  <Overprint text={c.label} size="l" />
  <p class="lede">{c.about}</p>
  {entries.length > 0
    ? <ul class="entry-list">{entries.map((e) => <EntryCard entry={e} />)}</ul>
    : <p class="prose">Nothing here yet.</p>}
</Base>
