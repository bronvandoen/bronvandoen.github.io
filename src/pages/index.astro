---
// Placeholder start page: the latest entries. The real home template comes in step 4.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import EntryMeta from '../components/EntryMeta.astro';

const entries = (await getCollection('entries')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf() || a.data.title.localeCompare(b.data.title),
);
---
<Base title="Bron van Doen research archive" noindex>
  <h1>Bron van Doen research archive</h1>
  <p class="muted">Social and service design research in Eindhoven, with a Situated Studio. Work in progress.</p>
  <h2>Latest</h2>
  <ul class="entries">
    {entries.map((e) => (
      <li>
        <a href={`/entries/${e.id}/`}><strong>{e.data.title}</strong></a>
        <EntryMeta entry={e} />
        <p>{e.data.summary}</p>
      </li>
    ))}
  </ul>
  <h2>Elsewhere</h2>
  <p><a href="https://opgeruimdebende.github.io/">Opgeruimde Bende</a>, our game research practice</p>
</Base>
