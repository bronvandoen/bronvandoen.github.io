---
import { fmtDate, isoDate, type Entry } from '../lib/entries';
interface Props { entry: Entry }
const d = Astro.props.entry.data;
---
<p class="meta">
  <span><time datetime={isoDate(d.date)}>{fmtDate(d.date)}</time></span>
  {d.audio && <span>Voice memo, {d.audioLength}</span>}
  {d.updated && <span>updated <time datetime={isoDate(d.updated)}>{fmtDate(d.updated)}</time></span>}
  {d.voices && <span>Voices: {d.voices.join(' and ')}</span>}
</p>
